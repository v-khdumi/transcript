# Azure AI Foundry Speech resource credentials
# Create a "Speech" resource in Azure AI Foundry / Azure AI services and copy its key + region.
AZURE_SPEECH_KEY=your-azure-speech-key
AZURE_SPEECH_REGION=westeurope

# Optional: use a custom Azure AI Foundry endpoint instead of AZURE_SPEECH_REGION
# AZURE_SPEECH_ENDPOINT=https://<your-resource-name>.cognitiveservices.azure.com

# Recognition language (BCP-47 code), e.g. ro-RO, en-US
AZURE_SPEECH_LANGUAGE=ro-RO